{
  "expo": {
    "name": "BabyCare Companion",
    "slug": "babycare-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "babycarecompanion",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#EEF2F8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.ssvinod.babycarecompanion",
      "buildNumber": "1",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "BabyCare Companion uses notifications for medication and vaccination reminders.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.ssvinod.babycarecompanion",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#EEF2F8"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true,
      "permissions": [
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#4F46E5",
          "defaultChannel": "babycare-reminders"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "597caee2-b398-4aba-8238-c1dd68b67984"
      }
    },
    "owner": "ssvinod36"
  }
}
